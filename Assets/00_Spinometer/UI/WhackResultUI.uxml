    <ui:VisualElement name="alignment-values" picking-mode="Ignore" style="flex-grow: 1; position: absolute; top: 0; left: 0; bottom: 0; right: 0; width: 100%; height: 100%;" />
    <ui:SliderInt value="2" high-value="100" name="seek-position" fill="true" show-input-field="true" style="position: absolute; left: 200px; right: 200px; top: 600px;">
        <Bindings>
