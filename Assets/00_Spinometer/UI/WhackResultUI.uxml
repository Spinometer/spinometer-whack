            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="VisualElement" style="flex-grow: 1; width: 400px; align-items: flex-end;">
            <ui:VisualElement name="VisualElement" style="flex-grow: 1;">
                <ui:Label text="webcam state" style="align-items: flex-start; align-self: flex-start;">
                    <Bindings>
                        <ui:DataBinding property="text" binding-mode="ToTarget" data-source="project://database/Assets/00_SpineMeter/UI/uiDataSourceInstance.asset?fileID=11400000&amp;guid=b0642bbdcbe8c274cbcf9e8f7dee90dc&amp;type=2#uiDataSourceInstance" data-source-path="webCamStateString" />
