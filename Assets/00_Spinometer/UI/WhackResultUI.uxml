                <ui:Label text="of 100&#x9;" picking-mode="Ignore" style="position: relative; top: 0; left: auto; font-size: 36px; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0;" />
