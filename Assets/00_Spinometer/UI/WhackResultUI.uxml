                                <ui:DataBinding property="text" binding-mode="ToTarget" data-source="project://database/Assets/00_SpineMeter/UI/uiDataSourceInstance.asset?fileID=11400000&amp;guid=b0642bbdcbe8c274cbcf9e8f7dee90dc&amp;type=2#uiDataSourceInstance" data-source-path="pitchStr" />
